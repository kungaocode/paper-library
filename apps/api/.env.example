# Paper repository root. The default is inferred from apps/api/app/config.py.
PAPER_ROOT=/home/kun/Desktop/paper

# Set to mock for offline pipeline testing. Use openai-compatible for a real model.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_OUTPUT_TOKENS=6000
LLM_JSON_MODE=true

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Leave AUTH_PASSWORD empty to keep the trusted-LAN preview login disabled.
# When set, all /api routes except /api/auth/* require a signed session cookie.
AUTH_USERNAME=admin
AUTH_PASSWORD=
# Recommended random value. If empty, AUTH_PASSWORD is used as the signing key.
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_HOURS=24
# Enable only when the API itself is served over HTTPS.
AUTH_COOKIE_SECURE=false

# Set true only for local development against private test servers.
ALLOW_PRIVATE_URLS=false
MAX_DOWNLOAD_MB=120
MAX_TEXT_CHARS=120000
ANALYSIS_PAGE_LIMIT=45
