# Research Studio API configuration. Independent from apps/api/.env.
# Copy to .env and adjust. Model fields are intentionally left blank: the whole
# pipeline runs offline with RESEARCH_LLM_PROVIDER=mock until you fill them in.

# Paper repository root (defaults to the repo containing apps/research-api).
RESEARCH_PAPER_ROOT=/home/kun/Desktop/paper
RESEARCH_STORAGE_DIR=/home/kun/Desktop/paper/storage/research

# mock = deterministic offline pipeline. openai-compatible = real strong model.
RESEARCH_LLM_PROVIDER=mock
RESEARCH_LLM_BASE_URL=
RESEARCH_LLM_API_KEY=
RESEARCH_LLM_MODEL=
RESEARCH_LLM_TIMEOUT_SECONDS=600
RESEARCH_LLM_MAX_OUTPUT_TOKENS=8000
RESEARCH_LLM_JSON_MODE=true

# Deep innovation extraction (reads PDFs, costs tokens). Keep small for a first run.
RESEARCH_ANALYSIS_CONCURRENCY=2
RESEARCH_ANALYSIS_PAGE_LIMIT=45
RESEARCH_ANALYSIS_MAX_CHARS=120000

# Hybrid retrieval tuning.
RESEARCH_RETRIEVAL_TOP_K=8
RESEARCH_RETRIEVAL_CANDIDATE_K=40
RESEARCH_LEXICAL_WEIGHT=0.45
RESEARCH_DEDUPE_THRESHOLD=0.92

# builtin = SQLite FTS5 + hashing vectors shipped here.
# knowledge_vector = delegate to /home/kun/Desktop/vector_library once it is ready.
RESEARCH_RETRIEVAL_BACKEND=builtin
KNOWLEDGE_VECTOR_ROOT=
KNOWLEDGE_VECTOR_DB=

RESEARCH_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
